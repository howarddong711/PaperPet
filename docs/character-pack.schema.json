{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperpet.invalid/schemas/character-pack-v1.json",
  "title": "PaperPet Character Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "author",
    "license",
    "renderer",
    "actions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "string", "minLength": 1, "maxLength": 40 },
    "author": { "type": "string", "minLength": 1, "maxLength": 120 },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "renderer": {
      "enum": [
        "static-image",
        "animated-image",
        "frame-sequence",
        "spritesheet"
      ]
    },
    "actions": {
      "type": "object",
      "required": ["idle", "reading", "thinking", "sleeping"],
      "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,47}$" },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/action" },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": { "$ref": "#/$defs/action" }
          }
        ]
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "durationMs": { "type": "number", "minimum": 100, "maximum": 60000 },
        "loop": { "type": "boolean" },
        "framesPerSecond": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 30
        },
        "audio": { "type": "string", "minLength": 1 }
      }
    }
  }
}
